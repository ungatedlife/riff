{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riff",
  "version": "0.4.3",
  "identifier": "media.ungated.riff",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Riff",
        "width": 1100,
        "height": 780,
        "minWidth": 580,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      },
      {
        "label": "quickie",
        "title": "Quickie",
        "url": "index.html?window=quickie",
        "width": 520,
        "height": 350,
        "minWidth": 380,
        "minHeight": 280,
        "maxWidth": 640,
        "maxHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      },
      {
        "label": "spark",
        "title": "Spark",
        "url": "index.html?window=spark",
        "width": 600,
        "height": 340,
        "minWidth": 420,
        "minHeight": 260,
        "maxWidth": 760,
        "maxHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      },
      {
        "label": "command-palette",
        "title": "Drafts",
        "url": "index.html?window=command-palette",
        "width": 700,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "index.html?window=settings",
        "width": 860,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: http://asset.localhost https://asset.localhost https: http:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/Riff/**",
          "$DOCUMENT/Riff/**/.assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzQjY2QjQyODIyMkQ2RTkKUldUcDFpS0NRbXUySXlWeU93TVBPL21TV2UxNWZtSlYwV0hQbEFBRGR6di9mRUF4b252V29pZE0K",
      "endpoints": [
        "https://github.com/ungatedlife/riff/releases/latest/download/latest.json"
      ]
    }
  }
}
